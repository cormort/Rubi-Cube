{
  "id": "./",
  "name": "圖論魔術方塊 - Kociemba 完整版",
  "short_name": "圖論魔方",
  "description": "以 54 張貼紙的環狀軌道視覺化 3x3x3 魔術方塊的置換結構，內建 Kociemba 兩階段求解器、OLL / PLL 公式庫與 3D 觸控操作。",
  "lang": "zh-Hant",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#07101d",
  "theme_color": "#07101d",
  "categories": ["education", "games", "utilities"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ],
  "screenshots": [
    {
      "src": "screenshots/install-mobile.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "手機單指滑貼紙轉層，十字羅盤可直接按面轉動"
    },
    {
      "src": "screenshots/install-desktop.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "桌機雙欄：3D 方塊與 54 貼紙環狀軌道並排"
    }
  ],
  "shortcuts": [
    {
      "name": "隨機打亂 20 步",
      "short_name": "打亂",
      "description": "開啟後立刻打亂方塊",
      "url": "./?do=scramble",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "解法教學與 OLL / PLL 公式庫",
      "short_name": "解法教學",
      "description": "直接開啟層先法與公式庫",
      "url": "./?do=tutorial",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
